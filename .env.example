# Copy to .env.local and fill in to enable optional integrations.
# All variables are read at build time (`npm run build`). Astro exposes PUBLIC_*
# variables to client code; VITE_* is also exposed (astro.config.mjs
# `vite.envPrefix`) so values set before the Astro migration keep working.
# On Cloudflare Pages, set them under Settings > Environment variables.

# Privacy-friendly analytics (Plausible). Leave empty to disable.
# Set to the site domain registered in Plausible, e.g. wb-aviation.pages.dev
# (PUBLIC_PLAUSIBLE_DOMAIN takes precedence over the legacy VITE_PLAUSIBLE_DOMAIN.)
PUBLIC_PLAUSIBLE_DOMAIN=
# VITE_PLAUSIBLE_DOMAIN=
