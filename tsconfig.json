{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": [
    "src/types.d.ts",
    "src/utils/**/*.js",
    "src/data/**/*.js",
    "src/hooks/**/*.js",
    "src/i18n/**/*.js"
  ],
  "exclude": ["**/*.test.js", "**/*.test.jsx"]
}
