---
/**
 * Not found page (/404.html, served by Cloudflare Pages for unknown URLs).
 * One page for every language: it cannot know which one the visitor wants,
 * so it lists the localized homes. Not indexed.
 */
import Base from "../layouts/Base.astro"
import { locales, localeNames } from "../i18n"
import { DEFAULT_ROUTE_LOCALE, ROUTE_LOCALES, guidesIndexPath, localePath } from "../utils/routes"

const s = locales[DEFAULT_ROUTE_LOCALE].seo
---

<Base lang="en" title={`404 | ${s.siteName}`} description="Page not found." path="/404.html" noindex>
  <main class="mx-auto max-w-2xl space-y-6 px-4 py-12">
    <p class="text-sm font-semibold tracking-wide text-blue-700">404</p>
    <h1 class="text-3xl font-bold text-gray-900">Page not found</h1>
    <ul class="space-y-4">
      {
        ROUTE_LOCALES.map((locale) => (
          <li lang={locale} class="rounded-xl bg-white/80 p-4 shadow-sm">
            <p class="text-sm text-gray-600">{localeNames[locale]}</p>
            <a
              href={localePath(locale)}
              hreflang={locale}
              class="text-lg font-semibold text-blue-700 hover:underline"
            >
              {locales[locale].seo.home.h1}
            </a>
            <span aria-hidden="true" class="px-1 text-gray-400">·</span>
            <a href={guidesIndexPath(locale)} hreflang={locale} class="text-blue-700 hover:underline">
              {locales[locale].guides.navLabel}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
