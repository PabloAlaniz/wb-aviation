---
/** Localized landing page: static intro + supported aircraft + calculator. */
import Base from "../../layouts/Base.astro"
import LanguageNav from "../../components/LanguageNav.astro"
import Calculator from "../../components/Calculator.astro"
import { locales } from "../../i18n"
import { aircraftData } from "../../data/aircraft"
import {
  ROUTE_LOCALES,
  absoluteUrl,
  aircraftPath,
  alternateLinks,
  guidePath,
  guidesIndexPath,
  localePath,
  type RouteLocale,
} from "../../utils/routes"
import { softwareApplicationJsonLd } from "../../utils/seoContent"
import { guidesFor } from "../../components/guides/collection"

export function getStaticPaths() {
  return ROUTE_LOCALES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as RouteLocale
const m = locales[lang]
const s = m.seo
const path = localePath(lang)
const { entries: guides } = await guidesFor(lang)
const jsonLd = [
  softwareApplicationJsonLd({
    name: s.siteName,
    description: s.appDescription,
    url: absoluteUrl(path),
    locale: lang,
  }),
]
---

<Base
  lang={lang}
  title={s.home.title}
  description={s.home.description}
  path={path}
  alternates={alternateLinks(localePath, "/")}
  pinLocale
  jsonLd={jsonLd}
>
  <header class="mx-auto max-w-4xl space-y-3 px-4 pt-4 print:hidden">
    <LanguageNav current={lang} pathFor={localePath} label={s.languageLabel} />
    <h1 class="text-3xl font-bold text-gray-900">{s.home.h1}</h1>
    <p class="text-gray-700">{s.home.intro1}</p>
    <p class="text-gray-700">{s.home.intro2}</p>
  </header>

  <main>
    <Calculator
      title={s.calculatorTitle}
      loading={s.loading}
      noscript={s.noscript}
      locale={lang}
    />

    <section class="mx-auto max-w-4xl px-4 pb-8 print:hidden">
      <h2 class="mb-2 text-xl font-semibold text-gray-900">{s.home.aircraftListTitle}</h2>
      <ul class="list-disc space-y-1 pl-6">
        {
          Object.entries(aircraftData).map(([id, aircraft]) => (
            <li>
              <a href={aircraftPath(lang, id)} class="text-blue-700 hover:underline">
                {s.home.aircraftLink(aircraft.name)}
              </a>{" "}
              <span class="text-sm text-gray-600">({aircraft.tcds})</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mx-auto max-w-4xl px-4 pb-8 print:hidden">
      <h2 class="mb-1 text-xl font-semibold text-gray-900">
        <a href={guidesIndexPath(lang)} class="hover:underline">{m.guides.homeTitle}</a>
      </h2>
      <p class="mb-2 text-gray-700">{m.guides.homeIntro}</p>
      <ul class="list-disc space-y-1 pl-6">
        {
          guides.map((entry) => (
            <li>
              <a href={guidePath(lang, entry.data.slug)} class="text-blue-700 hover:underline">
                {entry.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Base>
