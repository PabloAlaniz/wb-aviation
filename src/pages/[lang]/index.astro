---
/** Localized landing page: static intro + supported aircraft + calculator. */
import Base from "../../layouts/Base.astro"
import LanguageNav from "../../components/LanguageNav.astro"
import Calculator from "../../components/Calculator.astro"
import { locales } from "../../i18n"
import { aircraftData, aircraftGroups } from "../../data/aircraft"
import {
  ROUTE_LOCALES,
  aboutPath,
  absoluteUrl,
  aircraftPath,
  glossaryPath,
  alternateLinks,
  guidePath,
  guidesIndexPath,
  localePath,
  type RouteLocale,
} from "../../utils/routes"
import { softwareApplicationJsonLd, webSiteJsonLd } from "../../utils/seoContent"
import { ogImagePath } from "../../utils/ogImage"
import { pagesContent } from "../../content/pages"
import { guidesFor } from "../../components/guides/collection"

export function getStaticPaths() {
  return ROUTE_LOCALES.map((lang) => ({ params: { lang } }))
}

const lang = Astro.params.lang as RouteLocale
const m = locales[lang]
const s = m.seo
const pages = pagesContent[lang]
const path = localePath(lang)
const { entries: guides } = await guidesFor(lang)
const jsonLd = [
  softwareApplicationJsonLd({
    name: s.siteName,
    description: s.appDescription,
    url: absoluteUrl(path),
    locale: lang,
    image: absoluteUrl(ogImagePath(lang)),
  }),
  webSiteJsonLd({ name: s.siteName, description: s.appDescription, locales: ROUTE_LOCALES }),
]
---

<Base
  lang={lang}
  title={s.home.title}
  description={s.home.description}
  path={path}
  alternates={alternateLinks(localePath, "/")}
  pinLocale
  jsonLd={jsonLd}
  ogImage={ogImagePath(lang)}
>
  <header class="mx-auto max-w-4xl space-y-3 px-4 pt-4 print:hidden">
    <LanguageNav current={lang} pathFor={localePath} label={s.languageLabel} />
    <h1 class="text-3xl font-bold text-gray-900">{s.home.h1}</h1>
    <p class="text-gray-700">{s.home.intro1}</p>
    <p class="text-gray-700">{s.home.intro2}</p>
  </header>

  <main>
    <Calculator
      title={s.calculatorTitle}
      loading={s.loading}
      noscript={s.noscript}
      locale={lang}
    />

    <section class="mx-auto max-w-4xl px-4 pb-8 print:hidden">
      <h2 class="mb-2 text-xl font-semibold text-gray-900">{s.home.aircraftListTitle}</h2>
      {
        aircraftGroups.map(({ category, ids }) => (
          <>
            <h3 class="mt-3 mb-1 font-semibold text-gray-800">{m.app.aircraftGroups[category]}</h3>
            <ul class="list-disc space-y-1 pl-6">
              {ids.map((id) => (
                <li>
                  <a href={aircraftPath(lang, id)} class="text-blue-700 hover:underline">
                    {s.home.aircraftLink(aircraftData[id].name)}
                  </a>{" "}
                  <span class="text-sm text-gray-600">({aircraftData[id].tcds})</span>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </section>

    <section class="mx-auto max-w-4xl px-4 pb-8 print:hidden">
      <h2 class="mb-1 text-xl font-semibold text-gray-900">
        <a href={guidesIndexPath(lang)} class="hover:underline">{m.guides.homeTitle}</a>
      </h2>
      <p class="mb-2 text-gray-700">{m.guides.homeIntro}</p>
      <ul class="list-disc space-y-1 pl-6">
        {
          guides.map((entry) => (
            <li>
              <a href={guidePath(lang, entry.data.slug)} class="text-blue-700 hover:underline">
                {entry.data.title}
              </a>
            </li>
          ))
        }
        <li>
          <a href={glossaryPath(lang)} class="text-blue-700 hover:underline">{pages.glossary.h1}</a>
        </li>
        <li>
          <a href={aboutPath(lang)} class="text-blue-700 hover:underline">{pages.about.h1}</a>
        </li>
      </ul>
    </section>
  </main>
</Base>
