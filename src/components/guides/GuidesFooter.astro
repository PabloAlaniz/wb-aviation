---
/** Static footer of the guide pages (they don't load the calculator island). */
import { locales } from "../../i18n"
import { guidesIndexPath, localePath, type RouteLocale } from "../../utils/routes"
import { AUTHOR_NAME, AUTHOR_URL, REPO_URL } from "../Footer.jsx"

interface Props {
  lang: RouteLocale
}

const { lang } = Astro.props
const m = locales[lang]
---

<footer class="space-y-2 border-t border-blue-200 pt-4 pb-2 text-center text-xs text-gray-600">
  <p class="mx-auto max-w-2xl">{m.guides.disclaimer}</p>
  <p class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
    <a href={localePath(lang)} class="font-medium text-blue-700 hover:underline"
      >{m.seo.calculatorTitle}</a
    >
    <span aria-hidden="true">·</span>
    <a href={guidesIndexPath(lang)} class="font-medium text-blue-700 hover:underline"
      >{m.guides.footerLink}</a
    >
    <span aria-hidden="true">·</span>
    <span
      >{m.footer.madeBy}
      <a href={AUTHOR_URL} rel="noopener noreferrer" class="font-medium text-gray-800 hover:underline"
        >{AUTHOR_NAME}</a
      ></span
    >
    <span aria-hidden="true">·</span>
    <a href={REPO_URL} rel="noopener noreferrer" class="hover:underline">{m.footer.sourceCode}</a>
  </p>
</footer>
